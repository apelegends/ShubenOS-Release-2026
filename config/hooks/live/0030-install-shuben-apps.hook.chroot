#!/bin/bash
# Shuben Launcher OS — Install all custom apps and configure the desktop
set -e
echo "==> Installing Shuben Launcher apps..."

# ── Python deps ───────────────────────────────────────────────────────────
pip3 install --break-system-packages \
  requests pillow pycairo PyGObject 2>/dev/null || true

# ── Make all Python scripts executable ────────────────────────────────────
find /usr/lib/shuben-launcher -name "*.py" -exec chmod +x {} \;

# ── /usr/bin wrappers ─────────────────────────────────────────────────────
cat > /usr/bin/shuben-oobe << 'EOF'
#!/bin/bash
exec python3 /usr/lib/shuben-launcher/oobe/oobe.py "$@"
EOF

cat > /usr/bin/shuben-lock << 'EOF'
#!/bin/bash
exec python3 /usr/lib/shuben-launcher/login/pinlock.py "$@"
EOF

cat > /usr/bin/shuben-taskbar << 'EOF'
#!/bin/bash
exec python3 /usr/lib/shuben-launcher/desktop/taskbar.py "$@"
EOF

cat > /usr/bin/shuben-minecraft-launcher << 'EOF'
#!/bin/bash
exec python3 /usr/lib/shuben-launcher/minecraft/launcher.py "$@"
EOF

cat > /usr/bin/shuben-settings << 'EOF'
#!/bin/bash
exec python3 /usr/lib/shuben-launcher/settings/settings.py "$@"
EOF

cat > /usr/bin/shuben-power-menu << 'EOF'
#!/bin/bash
# Simple power menu using zenity
CHOICE=$(zenity --list \
  --title="Power options" \
  --column="Action" \
  "Shut down" "Restart" "Suspend" "Lock screen" 2>/dev/null)
case "$CHOICE" in
  "Shut down") systemctl poweroff ;;
  "Restart")   systemctl reboot ;;
  "Suspend")   systemctl suspend ;;
  "Lock screen") shuben-lock ;;
esac
EOF

chmod +x /usr/bin/shuben-oobe \
         /usr/bin/shuben-lock \
         /usr/bin/shuben-taskbar \
         /usr/bin/shuben-minecraft-launcher \
         /usr/bin/shuben-settings \
         /usr/bin/shuben-power-menu

# ── .desktop files ────────────────────────────────────────────────────────
cat > /usr/share/applications/shuben-minecraft.desktop << 'EOF'
[Desktop Entry]
Name=Minecraft Launcher
Comment=Launch Minecraft via Shuben Launcher
Exec=shuben-minecraft-launcher
Icon=shuben-minecraft
Terminal=false
Type=Application
Categories=Game;
EOF

cat > /usr/share/applications/shuben-settings.desktop << 'EOF'
[Desktop Entry]
Name=Shuben Settings
Comment=Configure Shuben Launcher OS
Exec=shuben-settings
Icon=preferences-system
Terminal=false
Type=Application
Categories=Settings;
EOF

# ── Openbox autostart ─────────────────────────────────────────────────────
mkdir -p /etc/skel/.config/openbox
cat > /etc/skel/.config/openbox/autostart << 'OBAEOF'
# Shuben Launcher OS — Openbox autostart

# Compositor for transparency
picom --daemon --config /dev/null &

# Wallpaper
feh --bg-scale /usr/share/shuben-launcher/wallpapers/desktop.jpg &

# Taskbar
shuben-taskbar &

# OOBE on first boot
if [ ! -f /var/lib/shuben/oobe-state.json ] || \
   ! python3 -c "import json; d=json.load(open('/var/lib/shuben/oobe-state.json')); exit(0 if d.get('oobe_complete') else 1)" 2>/dev/null; then
  sleep 1
  shuben-oobe
fi

# Pin lock on every login (after OOBE)
if [ -f /var/lib/shuben/pin.json ]; then
  sleep 0.5
  shuben-lock &
fi

# Minecraft launcher on first full boot
if [ ! -f /var/lib/shuben/.mc-launched ]; then
  sleep 3
  touch /var/lib/shuben/.mc-launched
  shuben-minecraft-launcher &
fi
OBAEOF

# ── Openbox rc.xml (keybindings) ──────────────────────────────────────────
cat > /etc/skel/.config/openbox/rc.xml << 'RCEOF'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>
  <desktops><number>1</number></desktops>
  <resize><drawContents>yes</drawContents></resize>
  <keyboard>
    <keybind key="Super_L">
      <action name="Execute"><command>shuben-taskbar</command></action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute"><command>lxterminal</command></action>
    </keybind>
    <keybind key="C-A-l">
      <action name="Execute"><command>shuben-lock</command></action>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="Super-d">
      <action name="ShowDesktop"/>
    </keybind>
  </keyboard>
  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <context name="Desktop">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>
  <menu>
    <file>/var/lib/openbox/debian-menu.xml</file>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
  </menu>
  <applications/>
</openbox_config>
RCEOF

# ── GTK theme (dark, Windows 10-ish) ─────────────────────────────────────
mkdir -p /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=hicolor
gtk-font-name=Segoe UI 10
gtk-cursor-theme-name=Adwaita
gtk-application-prefer-dark-theme=1
gtk-button-images=1
gtk-menu-images=1
EOF

mkdir -p /etc/skel/.config/gtk-2.0
cat > /etc/skel/.config/gtk-2.0/gtkrc << 'EOF'
gtk-theme-name="Adwaita-dark"
gtk-font-name="Segoe UI 10"
EOF

# ── LightDM config (auto-login to shuben user, PIN takes over) ────────────
mkdir -p /etc/lightdm
cat > /etc/lightdm/lightdm.conf << 'EOF'
[Seat:*]
autologin-user=shuben
autologin-user-timeout=0
autologin-session=openbox
user-session=openbox
greeter-session=lightdm-gtk-greeter
EOF

# ── Create shuben user ────────────────────────────────────────────────────
useradd -m -s /bin/bash -G sudo,audio,video,plugdev,netdev shuben || true
echo "shuben:shuben" | chpasswd
# Lock password — PIN is used instead
passwd -l shuben

# ── Wallpaper placeholder (gradient via Python at build time) ─────────────
python3 << 'WALLEOF'
try:
    from PIL import Image, ImageDraw
    import os, math

    os.makedirs("/usr/share/shuben-launcher/wallpapers", exist_ok=True)

    # Desktop wallpaper — dark blue gradient with subtle grid
    img = Image.new("RGB", (1920, 1080))
    draw = ImageDraw.Draw(img)
    for y in range(1080):
        t = y / 1080
        r = int(5 + 15 * t)
        g = int(8 + 20 * t)
        b = int(20 + 40 * t)
        draw.line([(0, y), (1920, y)], fill=(r, g, b))
    # Grid lines
    for x in range(0, 1920, 80):
        draw.line([(x, 0), (x, 1080)], fill=(255, 255, 255, 8))
    for y in range(0, 1080, 80):
        draw.line([(0, y), (1920, y)], fill=(255, 255, 255, 8))
    # Brand text
    img.save("/usr/share/shuben-launcher/wallpapers/desktop.jpg", quality=95)

    # Lock screen — slightly blurred / darker version
    lock = img.copy()
    draw2 = ImageDraw.Draw(lock)
    draw2.rectangle([(0,0),(1920,1080)], fill=(0,0,0,120))
    lock.save("/usr/share/shuben-launcher/wallpapers/lockscreen.jpg", quality=90)
    print("Wallpapers generated.")
except Exception as e:
    print(f"Wallpaper generation skipped: {e}")
WALLEOF

echo "==> Shuben apps installed."

# ── Installer wrapper ─────────────────────────────────────────────────────
cat > /usr/bin/shuben-installer << 'IEOF'
#!/bin/bash
if [ "$(id -u)" -ne 0 ]; then
  pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" \
    python3 /usr/lib/shuben-launcher/installer/installer.py
else
  python3 /usr/lib/shuben-launcher/installer/installer.py
fi
IEOF
chmod +x /usr/bin/shuben-installer

cat > /usr/share/applications/shuben-installer.desktop << 'EOF2'
[Desktop Entry]
Name=Install Shuben Launcher OS
Comment=Install Shuben Launcher OS to your computer
Exec=shuben-installer
Icon=drive-harddisk
Terminal=false
Type=Application
Categories=System;
EOF2

# Desktop shortcut
cp /usr/share/applications/shuben-installer.desktop \
   /etc/skel/Desktop/ 2>/dev/null || true

echo "==> Installer app added."
