#!/bin/bash
# Install GPU auto-detection service
set -e
echo "==> Setting up GPU auto-detection..."

cat > /usr/bin/shuben-gpu-setup << 'GPUEOF'
#!/bin/bash
# Shuben Launcher OS — GPU Auto-Detection & Driver Setup
# Runs at first boot to detect and configure the best GPU driver

LOG="/var/log/shuben-gpu-setup.log"
exec > >(tee -a "$LOG") 2>&1

echo "[$(date)] Shuben GPU Setup starting..."

# Detect GPU(s)
GPU_INFO=$(lspci | grep -Ei "vga|3d|display")
echo "Detected GPU(s): $GPU_INFO"

NVIDIA_DETECTED=0
AMD_DETECTED=0
INTEL_DETECTED=0

echo "$GPU_INFO" | grep -qi "nvidia" && NVIDIA_DETECTED=1
echo "$GPU_INFO" | grep -qi "amd\|radeon\|advanced micro" && AMD_DETECTED=1
echo "$GPU_INFO" | grep -qi "intel" && INTEL_DETECTED=1

# ── Intel ──────────────────────────────────────────────────────────────
if [ "$INTEL_DETECTED" -eq 1 ]; then
  echo "Intel GPU detected — configuring Intel driver..."
  cat > /etc/X11/xorg.conf.d/20-intel.conf << 'EOF'
Section "Device"
  Identifier  "Intel Graphics"
  Driver      "intel"
  Option      "TearFree" "true"
  Option      "AccelMethod" "sna"
  Option      "DRI" "3"
EndSection
EOF
  # Enable GuC/HuC firmware loading for newer Intel GPUs
  if [ -d /sys/module/i915 ]; then
    echo "options i915 enable_guc=3 enable_psr=1" > /etc/modprobe.d/i915.conf
  fi
  echo "Intel: configured."
fi

# ── AMD ────────────────────────────────────────────────────────────────
if [ "$AMD_DETECTED" -eq 1 ]; then
  echo "AMD GPU detected — configuring AMDGPU driver..."
  cat > /etc/X11/xorg.conf.d/20-amd.conf << 'EOF'
Section "Device"
  Identifier  "AMD Graphics"
  Driver      "amdgpu"
  Option      "TearFree" "true"
  Option      "DRI" "3"
  Option      "AccelMethod" "glamor"
EndSection
EOF
  # Prefer amdgpu over radeon for GCN 1.1+ hardware
  echo "options amdgpu si_support=1 cik_support=1" > /etc/modprobe.d/amdgpu.conf
  echo "blacklist radeon" >> /etc/modprobe.d/amdgpu.conf
  update-initramfs -u -k all 2>/dev/null || true
  echo "AMD: configured."
fi

# ── NVIDIA (nouveau free driver — no proprietary by default) ──────────
if [ "$NVIDIA_DETECTED" -eq 1 ]; then
  echo "NVIDIA GPU detected — configuring nouveau driver..."
  cat > /etc/X11/xorg.conf.d/20-nvidia.conf << 'EOF'
Section "Device"
  Identifier  "NVIDIA Graphics"
  Driver      "nouveau"
  Option      "NoAccel" "false"
EndSection
EOF
  # Offer proprietary in settings — but default to nouveau (lightweight)
  echo "nouveau configured. Proprietary drivers available via Shuben Settings."
  echo "options nouveau modeset=1" > /etc/modprobe.d/nouveau.conf
fi

# ── Vulkan ICD setup ───────────────────────────────────────────────────
if [ "$AMD_DETECTED" -eq 1 ]; then
  update-alternatives --set x86_64-linux-gnu_egl_conf \
    /usr/share/glvnd/egl_vendor.d/50_mesa.json 2>/dev/null || true
fi

# Write detected GPU info for the OOBE/settings UI
mkdir -p /var/lib/shuben
cat > /var/lib/shuben/gpu-info.json << GPUJSON
{
  "nvidia": $NVIDIA_DETECTED,
  "amd": $AMD_DETECTED,
  "intel": $INTEL_DETECTED,
  "raw": "$(echo "$GPU_INFO" | head -3 | tr '"' "'")"
}
GPUJSON

echo "[$(date)] GPU setup complete."
GPUEOF

chmod +x /usr/bin/shuben-gpu-setup

# Systemd service to run GPU setup at first boot
cat > /etc/systemd/system/shuben-gpu-setup.service << 'EOF'
[Unit]
Description=Shuben GPU Auto-Detection and Driver Configuration
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service
ConditionPathExists=!/var/lib/shuben/gpu-setup-done

[Service]
Type=oneshot
ExecStart=/usr/bin/shuben-gpu-setup
ExecStartPost=/bin/touch /var/lib/shuben/gpu-setup-done
RemainAfterExit=yes
StandardOutput=journal

[Install]
WantedBy=multi-user.target
EOF

systemctl enable shuben-gpu-setup.service
echo "==> GPU auto-detection service installed."
