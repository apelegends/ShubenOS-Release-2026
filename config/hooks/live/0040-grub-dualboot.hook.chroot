#!/bin/bash
# Shuben Launcher OS — GRUB dual-boot configuration
set -e
echo "==> Configuring GRUB for dual-boot..."

cat > /etc/default/grub << 'EOF'
# Shuben Launcher OS — GRUB configuration
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="Shuben Launcher OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nomodeset"
GRUB_CMDLINE_LINUX=""
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE="1920x1080,auto"
GRUB_GFXPAYLOAD_LINUX="keep"
GRUB_DISABLE_OS_PROBER=false
EOF

# Custom GRUB theme
mkdir -p /boot/grub/themes/shuben
cat > /boot/grub/themes/shuben/theme.txt << 'EOF'
title-text: "Shuben Launcher OS"
title-color: "#00A8E8"
message-color: "#FFFFFF"
message-bg-color: "#0D1117"
desktop-color: "#0D1117"
terminal-box: "terminal_*.png"
terminal-font: "Unifont Regular 14"

+ boot_menu {
  left = 20%
  top = 30%
  width = 60%
  height = 40%
  item_color = "#8B949E"
  selected_item_color = "#FFFFFF"
  item_height = 32
  item_padding = 8
  item_spacing = 4
  selected_item_pixmap_style = "select_*.png"
  icon_width = 32
  icon_height = 32
  item_icon_space = 12
}

+ label {
  top = 88%
  left = 0
  width = 100%
  align = "center"
  text = "Shuben Launcher OS — by Apelegends"
  color = "#8B949E"
  font = "Unifont Regular 11"
}
EOF

# os-prober to detect Windows
apt-get install -y os-prober grub-customizer 2>/dev/null || true

# Calamares config for installer
mkdir -p /etc/calamares/modules

cat > /etc/calamares/branding/shuben/branding.desc << 'BEOF'
---
componentName: shuben
welcomeStyleCalamares: false
strings:
  productName: "Shuben Launcher OS"
  shortProductName: "Shuben Launcher"
  version: "1.0"
  shortVersion: "1.0"
  versionedName: "Shuben Launcher OS 1.0"
  bootloaderEntryName: "Shuben Launcher OS"
  productUrl: "https://github.com/apelegends/shuben-launcher-os"
  supportUrl: "https://github.com/apelegends/shuben-launcher-os/issues"
  knownIssuesUrl: "https://github.com/apelegends/shuben-launcher-os/issues"
  releaseNotesUrl: "https://github.com/apelegends/shuben-launcher-os"
images:
  productLogo: "logo.png"
  productIcon: "logo.png"
  productWelcome: "languages.png"
slideshow: "show.qml"
BEOF

echo "==> GRUB dual-boot config done."
